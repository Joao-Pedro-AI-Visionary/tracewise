{
  "tools": [
    {
      "name": "infer_api_spec",
      "title": "Infer API Spec",
      "description": "Infer an OpenAPI 3.1 document from redacted HAR or mitmproxy captures. Pass capture_path to inspect the capture with credential redaction first, or evidence_ids of existing inspect_web_network_capture evidence. Groups requests by method and templated path (numeric, UUID and long hex segments become {id}-style parameters), infers query parameters and JSON schemas for request bodies and responses, and marks a field required only when it appears in every sample. Every operation, parameter and schema property carries x-tracewise-evidence (evidence ids and record ordinals) and x-tracewise-confidence (observed or inferred). Aspects that were not observed, including redacted authentication schemes, unseen status codes and enum completeness, are recorded as residual unknowns. Emits Evidence with predicate_type tracewise.api-spec, confidence inferred, and evidence_links to the source network evidence. Credential values are never copied into the document.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^ev_[a-f0-9]{64}$"
            },
            "description": "Session evidence ids produced by inspect_web_network_capture."
          },
          "capture_path": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute local HAR or mitmproxy capture path. Inspected with credential redaction before inference."
          },
          "base_url": {
            "type": "string",
            "minLength": 1,
            "description": "Optional server URL. Requests outside this prefix are ignored and paths are made relative to it."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "OpenAPI info.title. Defaults to Inferred API."
          },
          "output_path": {
            "type": "string",
            "minLength": 1,
            "description": "Optional path where the OpenAPI document is written."
          }
        },
        "oneOf": [
          {
            "required": ["evidence_ids"],
            "not": { "required": ["capture_path"] }
          },
          {
            "required": ["capture_path"],
            "not": { "required": ["evidence_ids"] }
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "subject",
          "provider",
          "analysis_profile",
          "predicate_type",
          "operation",
          "parameters",
          "raw_result",
          "normalized_result",
          "confidence",
          "authority",
          "environment",
          "limitations",
          "locations",
          "evidence_links"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^ev_[a-f0-9]{64}$"
          },
          "subject": {
            "type": ["object", "null"]
          },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "version"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "version": { "type": ["string", "null"] }
            }
          },
          "analysis_profile": {},
          "predicate_type": { "const": "tracewise.api-spec" },
          "operation": { "const": "infer_api_spec" },
          "parameters": { "type": "object" },
          "raw_result": {},
          "normalized_result": {
            "type": "object",
            "required": ["openapi", "info", "paths", "x-tracewise-evidence", "x-tracewise-confidence", "x-tracewise-unknowns"],
            "properties": {
              "openapi": { "const": "3.1.0" },
              "info": { "type": "object" },
              "servers": { "type": "array" },
              "paths": { "type": "object" },
              "components": { "type": "object" },
              "x-tracewise-evidence": { "type": "array", "minItems": 1 },
              "x-tracewise-confidence": { "const": "inferred" },
              "x-tracewise-unknowns": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "confidence": { "const": "inferred" },
          "authority": { "const": "analyst-inference" },
          "environment": {},
          "limitations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "locations": { "type": "array" },
          "evidence_links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^ev_[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    {
      "name": "generate_api_client",
      "title": "Generate API Client",
      "description": "Generate typed TypeScript and Python API clients from an OpenAPI document. Pass spec_path or an inline spec object, languages (typescript and/or python), and output_directory. Optional package_name names the Python module and npm package. Optional replay_capture_path is a HAR or mitmproxy capture inspected with credential redaction before its exchanges become replay tests. TypeScript output is a fetch client with interfaces, package.json and tsconfig, plus node:test cases that mock fetch with recorded responses and assert the typed parse. Python output is a stdlib urllib client with dataclasses and unittest cases that replay those responses. The result lists each generated file with its sha256 and emits Evidence. Credential values are never copied into the SDK.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "spec_path": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute path of an OpenAPI JSON document. Evidence wrappers are unwrapped when normalized_result is the document."
          },
          "spec": {
            "type": "object",
            "description": "Inline OpenAPI document. Mutually exclusive with spec_path."
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["typescript", "python"] },
            "description": "SDKs to generate."
          },
          "output_directory": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute directory that receives the generated files."
          },
          "package_name": {
            "type": "string",
            "minLength": 1,
            "description": "Python module and npm package name. Defaults to a slug of info.title."
          },
          "replay_capture_path": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute HAR or mitmproxy capture. Inspected with credential redaction, then embedded as replay tests."
          }
        },
        "oneOf": [
          {
            "required": ["spec_path", "languages", "output_directory"],
            "not": { "required": ["spec"] }
          },
          {
            "required": ["spec", "languages", "output_directory"],
            "not": { "required": ["spec_path"] }
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "subject",
          "provider",
          "analysis_profile",
          "predicate_type",
          "operation",
          "parameters",
          "raw_result",
          "normalized_result",
          "confidence",
          "authority",
          "environment",
          "limitations",
          "locations",
          "evidence_links"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^ev_[a-f0-9]{64}$"
          },
          "subject": { "type": ["object", "null"] },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "version"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "version": { "type": ["string", "null"] }
            }
          },
          "analysis_profile": {},
          "predicate_type": { "const": "tracewise.api-client" },
          "operation": { "const": "generate_api_client" },
          "parameters": { "type": "object" },
          "raw_result": {},
          "normalized_result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["languages", "package_name", "output_directory", "files"],
            "properties": {
              "languages": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["python", "typescript"] }
              },
              "package_name": { "type": "string", "minLength": 1 },
              "output_directory": { "type": "string", "minLength": 1 },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256", "bytes"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                    "bytes": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          },
          "confidence": { "const": "inferred" },
          "authority": { "const": "analyst-inference" },
          "environment": {},
          "limitations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "locations": { "type": "array" },
          "evidence_links": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ev_[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  ]
}
