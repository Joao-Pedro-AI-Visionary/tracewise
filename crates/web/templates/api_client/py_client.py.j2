Transport = Callable[[str, str, dict, Optional[bytes]], tuple]


class ApiError(Exception):
    def __init__(self, status: int, body: Any) -> None:
        super().__init__("Unexpected status " + str(status))
        self.status = status
        self.body = body


def _encode_query(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def _fill_path(template: str, params: Any) -> str:
    rendered = template
    for key, spec in params.__dataclass_fields__.items():
        json_name = spec.metadata.get("json", key)
        rendered = rendered.replace(
            "{" + str(json_name) + "}",
            urllib.parse.quote(_encode_query(getattr(params, key)), safe=""),
        )
    return rendered


def _query_pairs(params: Any) -> list:
    pairs = []
    for key, spec in params.__dataclass_fields__.items():
        item = getattr(params, key)
        if item is None:
            continue
        json_name = spec.metadata.get("json", key)
        pairs.append((str(json_name), _encode_query(item)))
    return pairs


def _to_payload(value: Any) -> Any:
    if is_dataclass(value):
        payload = {}
        for key, spec in value.__dataclass_fields__.items():
            item = getattr(value, key)
            if item is None:
                continue
            json_name = spec.metadata.get("json", key)
            payload[str(json_name)] = _to_payload(item)
        return payload
    if isinstance(value, list):
        return [_to_payload(item) for item in value]
    if isinstance(value, dict):
        return {str(key): _to_payload(item) for key, item in value.items()}
    return value


def _urllib_transport(method: str, url: str, headers: dict, body: Optional[bytes]) -> tuple:
    request = urllib.request.Request(url, data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request) as response:
            return response.status, response.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read().decode("utf-8")


class Client:
    def __init__(self, base_url: str = {{ base_url_literal }}, transport: Optional[Transport] = None, headers: Optional[dict] = None) -> None:
        self.base_url = base_url.rstrip("/")
        self.transport = transport or _urllib_transport
        self.headers = dict(headers or {})

