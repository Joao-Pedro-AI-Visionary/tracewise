// Fetch client generated by tracewise. Authentication headers are caller-supplied.
// Redacted credentials from the capture are not embedded.

{% if type_imports %}
import type { {{ type_imports | join(", ") }} } from "./types.js";
{% endif %}
{% if value_imports %}
import { {{ value_imports | join(", ") }} } from "./types.js";
{% endif %}

export interface FetchInit {
  method?: string;
  headers?: Record<string, string>;
  body?: string;
}

export interface FetchResponse {
  status: number;
  text(): Promise<string>;
}

export type FetchLike = (url: string, init?: FetchInit) => Promise<FetchResponse>;

export interface ClientOptions {
  baseUrl?: string;
  fetch?: FetchLike;
  headers?: Record<string, string>;
}

declare function fetch(url: string, init?: FetchInit): Promise<FetchResponse>;

export class Client {
  private readonly baseUrl: string;
  private readonly fetchImpl: FetchLike;
  private readonly headers: Record<string, string>;

  constructor(options: ClientOptions = {}) {
    const base = options.baseUrl ?? {{ base_url_literal }};
    this.baseUrl = base.endsWith("/") ? base.slice(0, -1) : base;
    this.fetchImpl = options.fetch ?? ((url, init) => fetch(url, init));
    this.headers = options.headers ?? {};
  }

  private async call(
    method: string,
    path: string,
    query: object | undefined,
    body: unknown,
  ): Promise<{ status: number; body: unknown }> {
    let url = this.baseUrl + path;
    if (query !== undefined) {
      const parts: string[] = [];
      for (const [key, value] of Object.entries(query)) {
        if (value === undefined || value === null) {
          continue;
        }
        parts.push(encodeURIComponent(key) + "=" + encodeURIComponent(encodeQueryValue(value)));
      }
      if (parts.length > 0) {
        url += "?" + parts.join("&");
      }
    }
    const headers: Record<string, string> = { Accept: "application/json" };
    const init: FetchInit = { method, headers };
    if (body !== undefined) {
      headers["Content-Type"] = "application/json";
      init.body = JSON.stringify(body);
    }
    for (const [key, value] of Object.entries(this.headers)) {
      headers[key] = value;
    }
    const response = await this.fetchImpl(url, init);
    const text = await response.text();
    const parsed = text.length === 0 ? null : JSON.parse(text) as unknown;
    return { status: response.status, body: parsed };
  }

{% for op in operations %}
  async {{ op.operation_id }}({{ op.ts_params }}): Promise<{{ op.ts_result }}> {
    const rendered = {{ op.path_code_ts }};
    const result = await this.call({{ op.method_literal }}, rendered, {{ op.query_code_ts }}, {{ op.body_code_ts }});
{% if op.responses %}
{% for resp in op.responses %}
    if (result.status === {{ resp.status }}) {
      return { status: {{ resp.status }}, body: {{ resp.ts_body }} };
    }
{% endfor %}
    throw new Error("Unexpected status " + String(result.status));
{% else %}
    return { status: result.status, body: result.body };
{% endif %}
  }

{% endfor %}
}

function encodeQueryValue(value: unknown): string {
  if (typeof value === "boolean") {
    return value ? "true" : "false";
  }
  if (value === null || value === undefined) {
    return "";
  }
  return String(value);
}
