#!/usr/bin/env python3
"""Fake Binwalk 3.1 for the firmware parity tests: exercises the report and
process failure paths the real tool cannot be made to produce on demand.

Environment:
  FAKE_FW_MODE            ok (default) or one of the modes below
  FAKE_FW_VERSION         `--version` banner (default "binwalk 3.1.0")
  FAKE_FW_BANNER_BYTES    pad the banner with this many extra bytes
  FAKE_FW_STDERR          text written to stderr by the scan
Modes: no_report, no_report_exit1, exit3, invalid_json, bom, non_utf8,
wrong_shape, not_array, two_records, other_path, extractions, oob, big_stdout,
xfsz, killed, stray, slow
"""
import json
import os
import signal
import subprocess
import sys

MODE = os.environ.get("FAKE_FW_MODE", "ok")
argv = sys.argv[1:]

if argv == ["--version"]:
    banner = os.environ.get("FAKE_FW_VERSION", "binwalk 3.1.0")
    sys.stdout.write(banner + "\n" + "x" * int(os.environ.get("FAKE_FW_BANNER_BYTES", "0")))
    sys.exit(0)

report_path = argv[argv.index("--log") + 1]
target = argv[-1]
size = os.path.getsize(target)


def signature(offset, length, name="fake", confidence=250):
    return {
        "offset": offset,
        "id": "00000000-0000-4000-8000-000000000001",
        "size": length,
        "name": name,
        "confidence": confidence,
        "description": "fake signature",
        "always_display": False,
        "extraction_declined": False,
    }


def analysis(file_path=None, hits=None, extractions=None):
    return {
        "Analysis": {
            "file_path": file_path or target,
            "file_map": hits if hits is not None else [signature(0, min(size, 100))],
            "extractions": extractions or {},
        }
    }


if os.environ.get("FAKE_FW_STDERR"):
    sys.stderr.write(os.environ["FAKE_FW_STDERR"])
    sys.stderr.flush()

body = [analysis()]
raw = None
if MODE == "no_report":
    sys.exit(0)
elif MODE == "no_report_exit1":
    sys.exit(1)
elif MODE == "exit3":
    sys.exit(3)
elif MODE == "invalid_json":
    raw = b"{"
elif MODE == "bom":
    raw = b"\xef\xbb\xbf[]"
elif MODE == "non_utf8":
    raw = b"\xff\xfe[]"
elif MODE == "wrong_shape":
    body = [{"Analysis": 5}]
elif MODE == "not_array":
    body = {}
elif MODE == "two_records":
    body = [analysis(), analysis()]
elif MODE == "other_path":
    body = [analysis(file_path="/somewhere/else.bin")]
elif MODE == "extractions":
    body = [analysis(extractions={"x": {}})]
elif MODE == "oob":
    body = [analysis(hits=[signature(size - 4, 99)])]
elif MODE == "big_stdout":
    sys.stdout.write("y" * (9 * 1024 * 1024))
    sys.stdout.flush()
elif MODE == "xfsz":
    with open(report_path, "wb") as handle:
        handle.write(b"z" * (9 * 1024 * 1024))
elif MODE == "killed":
    os.kill(os.getpid(), signal.SIGKILL)
elif MODE == "slow":
    # Cancellation fixture: a stray descendant plus a long scan.
    subprocess.Popen(
        [sys.executable, "-c", "import time; time.sleep(300)", os.environ.get("FAKE_FW_MARKER", "tw-fw-stray-default")],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    import time

    time.sleep(120)
elif MODE == "stray":
    # A descendant that outlives the tool in the same process group.
    subprocess.Popen(
        [sys.executable, "-c", "import time; time.sleep(300)", os.environ.get("FAKE_FW_MARKER", "tw-fw-stray-default")],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

with open(report_path, "wb") as handle:
    handle.write(raw if raw is not None else json.dumps(body).encode())
sys.stdout.write("fake binwalk scan complete\n")
